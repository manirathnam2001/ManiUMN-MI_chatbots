# Build artifacts and temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.tox
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Temporary files
/tmp/
*.tmp
*.log

# Application logs (rotated backups do not match the bare *.log rule above)
git_logs/
*.log.[0-9]*

# SMTP queue (keep directory, ignore log files)
SMTP logs/*.log
SMTP logs/*.log.*
smtp_queue/*.log
smtp_queue/*.log.*

# Student-identifying artifacts written by the email retry queue.
# These contain student names and generated MI evaluation PDFs and must
# never be committed. See email_queue.py.
SMTP logs/failed_emails.json
SMTP logs/queued_*.pdf
smtp_queue/failed_emails.json
smtp_queue/queued_*.pdf

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Credentials. The absence of a rule covering service account JSON is how a
# Google private key was previously committed to this repository.
.streamlit/secrets.toml
*service-account*.json
*-service-account.json
umnsod-mibot-*.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Sample PDFs for testing
sample_*.pdf
test_*.pdf
